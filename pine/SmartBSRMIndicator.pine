//@version=5
// SmartBSRMIndicator — overlay: 4 MAs, swing pivots, RollE, safe zones.
// Regime: bull/bear = RollE streak + MA + RSI; else sideways (sticky until RollE up/down).
indicator("SmartBSRMIndicator", overlay=true,
     max_bars_back=5000,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=100)

// ═══════════════════════════════════════════════════════════════════════
// Inputs
// ═══════════════════════════════════════════════════════════════════════
grpCore = "Core"
pivotLen = input.int(9, "Pivot lookback", minval=1, maxval=100, group=grpCore,
     tooltip="Bars before and after to confirm a high/low. Shared by zones and pivot-channel trendlines.")
kellySize = input.string("Quad", "Kelly size", options=["100%", "Half", "Quad"], group=grpCore)
showPivots = input.bool(false, "Show swing pivot triangles", group=grpCore,
     tooltip="ta.pivothigh/low triangles (confirm after Pivot lookback bars). Independent of RollE.")
showMa = input.bool(true, "Show 4 MAs", group=grpCore)

grpRolle = "RollE points"
showRollePoints = input.bool(true, "Show RollE points & links", group=grpRolle,
     tooltip="Rolling-extreme updates: high == max(high,L) or low == min(low,L). Circles + links between consecutive REH/REL.")
rolleLen = input.int(5, "RollE length L", minval=2, maxval=100, group=grpRolle,
     tooltip="Window for rolling max high / min low (same L as rolle_breakout labels). Try 5 / 9 / 12.")
showRolleLinks = input.bool(true, "Link consecutive RollE points", group=grpRolle)
showRolleExt = input.bool(false, "Show RollE dotted extensions", group=grpRolle,
     tooltip="Off = hide/clear RollE projection lines (points & solid links stay). On = ATR-filtered dotted extensions like swing pivots.")
rolleKeep = input.int(80, "Max RollE marks kept", minval=10, maxval=200, group=grpRolle)
colRolleHi = input.color(color.new(#FF7043, 0), "RollE high color", group=grpRolle)
colRolleLo = input.color(color.new(#7E57C2, 0), "RollE low color", group=grpRolle)
showRMarks = input.bool(true, "Mark RollE pivot R", group=grpRolle,
     tooltip="R on RollE highs/lows that are fractal pivots: highest/lowest in [lookback … lookforward] bars.")
rolleRLeft = input.int(3, "R look back", minval=1, maxval=50, group=grpRolle)
rolleRRight = input.int(3, "R look forward", minval=1, maxval=50, group=grpRolle)
colRHi = input.color(color.new(#EF5350, 0), "R high color", group=grpRolle)
colRLo = input.color(color.new(#26A69A, 0), "R low color", group=grpRolle)
rKeep = input.int(80, "Max R marks kept", minval=10, maxval=200, group=grpRolle)

grpRegime = "RollE regime"
showRegime = input.bool(true, "Show regime bgcolor", group=grpRegime,
     tooltip="Bull/bear: 2+ same-side RollE + not fully against fast MA + RSI. Otherwise sideways; sideways stays until a new RollE up/down break.")
regimeTrans = input.int(92, "Regime transparency", minval=70, maxval=98, step=1, group=grpRegime,
     tooltip="Pine transparency: higher = lower opacity (fainter). Default 92 ≈ 8% opacity.")
colRegUp = input.color(color.new(#26A69A, 0), "Regime up color", group=grpRegime)
colRegDn = input.color(color.new(#EF5350, 0), "Regime down color", group=grpRegime)
colRegSide = input.color(color.new(color.gray, 0), "Regime sideways color", group=grpRegime)
rsiRegLen = input.int(14, "Regime RSI length", minval=2, maxval=100, group=grpRegime)
rsiRegBull = input.float(50.0, "Bull RSI >", minval=40.0, maxval=90.0, step=1.0, group=grpRegime)
rsiRegBear = input.float(50.0, "Bear RSI <", minval=10.0, maxval=60.0, step=1.0, group=grpRegime)

grpLot = "Position size (zone width)"
baseLot = input.float(0.1, "Lot size", minval=0.01, step=0.01, group=grpLot,
     tooltip="Used for Kelly risk → max stop distance (zone width).")
accountSize = input.float(200.0, "Account size ($)", minval=1.0, step=10.0, group=grpLot,
     tooltip="Used for Kelly risk / zone width.")

grpZone = "Safe entry zones"
showZones = input.bool(true, "Show horizontal buy/sell zones", group=grpZone)
zoneSource = input.string("RollE", "Zone source", options=["RollE", "Swing pivots", "Both"], group=grpZone,
     tooltip="RollE or swing pivots as level source. Zones use highs above / lows below current price.")
zoneMode = input.string("Last 2", "Zone mode", options=["Last only", "Last 2"], group=grpZone,
     tooltip="Last only: one band each side. Last 2: up to two highest levels above price (sell) and two lowest below price (buy).")
zoneTrans = input.int(82, "Zone fill transparency", minval=50, maxval=95, step=1, group=grpZone)

grpTL = "Swing pivot channel"
showPivotChannel = input.bool(true, "Show swing pivot points & links", group=grpTL,
     tooltip="Fractal swing pivots (Pivot lookback): circles, pivot-to-pivot links, ATR extensions, Up/Down. Independent of RollE.")
tlExtBars = input.int(70, "Trendline extension (bars)", minval=1, group=grpTL,
     tooltip="How far to project extension lines and watch for breakouts.")
tlExtStyleIn = input.string("Dotted", "Extension line style", options=["Dashed", "Dotted", "Solid"], group=grpTL)
tlPhColor = input.color(color.blue, "Pivot high color", group=grpTL)
tlPlColor = input.color(color.lime, "Pivot low color", group=grpTL)
showTlDashes = input.bool(true, "Show last pivot price", group=grpTL,
     tooltip="Horizontal line and price label on the latest high and low pivots.")
tlDashStyleIn = input.string("Dashed", "Last-pivot line style", options=["Dashed", "Dotted", "Solid"], group=grpTL)
showTlDir = input.bool(true, "Mark all extension breakouts", group=grpTL,
     tooltip="Up when the full candle closes above the active high line/extension (low > line). Down when the full candle closes below the low line/extension (high < line).")
tlBreakMax = input.int(100, "Max breakout marks kept", minval=10, maxval=500, group=grpTL)

// Fixed defaults (not in settings)
maFastLen = 14
maMidLen = 48
maSlowLen = 120
maLongLen = 180
minLot = 0.01
maxLot = 10.0
usdPerLotPerPrice = 100.0  // XAU: 1.0 lot → $100 PnL per +$1 price

colBuy = #26A69A
colSell = #EF5350
colFast = #81D4FA
colMid = #26A69A
colSlow = #FFA726
colLongMa = #EF5350
colPivotHi = #EF5350
colPivotLo = #26A69A

// Lines / marks: opacity 30. Circles (pivot + RollE dots) only: opacity 70.
MARK_TRANS = 30
CIRCLE_TRANS = 70
f_mark(color c) =>
    color.new(c, MARK_TRANS)
f_circle(color c) =>
    color.new(c, CIRCLE_TRANS)

MAX_PAIRS = 2
ZONE_HIST = 40  // keep enough H/L history to pick levels vs current price

// ═══════════════════════════════════════════════════════════════════════
// Kelly risk ($) + lot → max stop distance in price
// ═══════════════════════════════════════════════════════════════════════
kellyFrac = kellySize == "100%" ? 1.0 : kellySize == "Half" ? 0.5 : 0.25
float riskAmount = accountSize * kellyFrac
float lotShow = math.max(minLot, math.min(maxLot, baseLot))
float moneyPerPrice = lotShow * usdPerLotPerPrice
float maxStopDist = riskAmount / math.max(moneyPerPrice, 1e-12)

// ═══════════════════════════════════════════════════════════════════════
// Shared pivots + 4 MAs
// ═══════════════════════════════════════════════════════════════════════
float phRaw = ta.pivothigh(high, pivotLen, pivotLen)
float plRaw = ta.pivotlow(low, pivotLen, pivotLen)
int pivBar = math.max(0, bar_index - pivotLen)

float maFast = ta.ema(close, maFastLen)
float maMid = ta.ema(close, maMidLen)
float maSlow = ta.ema(close, maSlowLen)
float maLong = ta.sma(close, maLongLen)

float atrPiv = ta.atr(pivotLen)
float atrCh = ta.atr(200)

// ═══════════════════════════════════════════════════════════════════════
// Last 2 pivot H/L — labels + entry bands
// Swing-pivot zones: break above H / below L removes that zone.
// RollE zones: keep last 1–2 updates (no break-drop).
// ═══════════════════════════════════════════════════════════════════════
var label[] phLabs = array.new_label()
var label[] plLabs = array.new_label()
var float[] phPrices = array.new_float()
var int[] phBars = array.new_int()
var float[] plPrices = array.new_float()
var int[] plBars = array.new_int()
var float[] reZonePhPrices = array.new_float()
var int[] reZonePhBars = array.new_int()
var float[] reZonePlPrices = array.new_float()
var int[] reZonePlBars = array.new_int()
var box[] buyBoxes = array.new_box()
var box[] sellBoxes = array.new_box()
var box[] buyBoxesRe = array.new_box()
var box[] sellBoxesRe = array.new_box()

f_trim_labs(label[] labs) =>
    while array.size(labs) > MAX_PAIRS
        label.delete(array.shift(labs))

f_clear_labs(label[] labs) =>
    while array.size(labs) > 0
        label.delete(array.shift(labs))

f_trim_zone(float[] prices, int[] bars) =>
    while array.size(prices) > ZONE_HIST
        array.shift(prices)
        array.shift(bars)

f_add_zone(float[] prices, int[] bars, float price, int xBar) =>
    array.push(prices, price)
    array.push(bars, xBar)
    f_trim_zone(prices, bars)

f_add_pivot_mark(label[] labs, float price, int xBar, color labCol, bool isHigh) =>
    color mc = f_mark(labCol)
    array.push(labs, label.new(xBar, price, "",
         style=isHigh ? label.style_triangledown : label.style_triangleup,
         color=mc,
         textcolor=mc,
         size=size.tiny))
    f_trim_labs(labs)

f_clear_boxes(box[] boxes) =>
    while array.size(boxes) > 0
        box.delete(array.shift(boxes))

f_sync_boxes(box[] boxes, int want) =>
    while array.size(boxes) > want
        box.delete(array.pop(boxes))
    while array.size(boxes) < want
        array.push(boxes, box.new(bar_index, close, bar_index, close, border_color=color.new(color.gray, 100), bgcolor=color.new(color.gray, 100), border_width=2))

float bandDist = math.max(maxStopDist, nz(atrPiv, maxStopDist))

if not na(phRaw) and showPivots
    f_add_pivot_mark(phLabs, phRaw, pivBar, colPivotHi, true)
if not na(plRaw) and showPivots
    f_add_pivot_mark(plLabs, plRaw, pivBar, colPivotLo, false)
if not showPivots
    f_clear_labs(phLabs)
    f_clear_labs(plLabs)

if barstate.isconfirmed
    if not na(phRaw)
        f_add_zone(phPrices, phBars, phRaw, pivBar)
    if not na(plRaw)
        f_add_zone(plPrices, plBars, plRaw, pivBar)

// Same-side bands overlap when their price intervals share range (width = bandDist).
f_zone_overlap(float a, float b) =>
    math.abs(a - b) < bandDist

f_idx_picked(int[] picked, int idx) =>
    bool found = false
    if array.size(picked) > 0
        for j = 0 to array.size(picked) - 1
            if array.get(picked, j) == idx
                found := true
                break
    found

// Among levels above ref, pick up to `keep` highest prices (newer wins ties); skip overlaps.
f_pick_highest_above(float[] prices, float ref, int keep) =>
    int[] picked = array.new_int()
    int n = array.size(prices)
    if n > 0 and keep > 0
        for k = 1 to keep
            int best = -1
            float bestPx = na
            for i = 0 to n - 1
                if f_idx_picked(picked, i)
                    continue
                float px = array.get(prices, i)
                if px <= ref
                    continue
                bool better = best < 0 or px > bestPx or (px == bestPx and i > best)
                if better
                    bool overlaps = false
                    if array.size(picked) > 0
                        for j = 0 to array.size(picked) - 1
                            if f_zone_overlap(px, array.get(prices, array.get(picked, j)))
                                overlaps := true
                                break
                    if not overlaps
                        best := i
                        bestPx := px
            if best < 0
                break
            array.push(picked, best)
    picked

// Among levels below ref, pick up to `keep` lowest prices (newer wins ties); skip overlaps.
f_pick_lowest_below(float[] prices, float ref, int keep) =>
    int[] picked = array.new_int()
    int n = array.size(prices)
    if n > 0 and keep > 0
        for k = 1 to keep
            int best = -1
            float bestPx = na
            for i = 0 to n - 1
                if f_idx_picked(picked, i)
                    continue
                float px = array.get(prices, i)
                if px >= ref
                    continue
                bool better = best < 0 or px < bestPx or (px == bestPx and i > best)
                if better
                    bool overlaps = false
                    if array.size(picked) > 0
                        for j = 0 to array.size(picked) - 1
                            if f_zone_overlap(px, array.get(prices, array.get(picked, j)))
                                overlaps := true
                                break
                    if not overlaps
                        best := i
                        bestPx := px
            if best < 0
                break
            array.push(picked, best)
    picked

f_paint_zones(box[] buyArr, box[] sellArr, float[] loPrices, int[] loBars, float[] hiPrices, int[] hiBars, color buyFill, color sellFill) =>
    int zoneKeep = zoneMode == "Last only" ? 1 : MAX_PAIRS
    int zoneRight = bar_index
    float pxRef = close
    // Buy: up to N lowest levels below price. Sell: up to N highest levels above price.
    int[] buyIdx = f_pick_lowest_below(loPrices, pxRef, zoneKeep)
    int nBuy = array.size(buyIdx)
    f_sync_boxes(buyArr, nBuy)
    if nBuy > 0
        for i = 0 to nBuy - 1
            int idx = array.get(buyIdx, i)
            float pl = array.get(loPrices, idx)
            int left = array.get(loBars, idx)
            box b = array.get(buyArr, i)
            box.set_lefttop(b, left, pl + bandDist)
            box.set_rightbottom(b, zoneRight, pl)
            box.set_bgcolor(b, buyFill)
            box.set_border_color(b, color.new(colBuy, 100))
            box.set_border_width(b, 0)
    int[] sellIdx = f_pick_highest_above(hiPrices, pxRef, zoneKeep)
    int nSell = array.size(sellIdx)
    f_sync_boxes(sellArr, nSell)
    if nSell > 0
        for i = 0 to nSell - 1
            int idx = array.get(sellIdx, i)
            float ph = array.get(hiPrices, idx)
            int left = array.get(hiBars, idx)
            box b = array.get(sellArr, i)
            box.set_lefttop(b, left, ph)
            box.set_rightbottom(b, zoneRight, ph - bandDist)
            box.set_bgcolor(b, sellFill)
            box.set_border_color(b, color.new(colSell, 100))
            box.set_border_width(b, 0)

// ═══════════════════════════════════════════════════════════════════════
// Pivot channel trendlines
// Adapted from Pivot Channel TrendLines [BigBeluga], CC BY-NC-SA 4.0.
// ═══════════════════════════════════════════════════════════════════════
tlDashStyle = tlDashStyleIn == "Dashed" ? line.style_dashed : tlDashStyleIn == "Dotted" ? line.style_dotted : line.style_solid
tlExtStyle = tlExtStyleIn == "Dashed" ? line.style_dashed : tlExtStyleIn == "Dotted" ? line.style_dotted : line.style_solid

var bool tlPhReady = false
var float tlPhVal = na
var int tlPhIndx = na
var bool tlPlReady = false
var float tlPlVal = na
var int tlPlIndx = na

var int tlUpperBar = na
var float tlUpperY = na
var float tlUpperSlope = na
var bool tlUpperOn = false
var int tlLowerBar = na
var float tlLowerY = na
var float tlLowerSlope = na
var bool tlLowerOn = false

var label[] tlBreakLabs = array.new_label()
var line tlPhDash = na
var label tlPhDashLab = na
var line tlPlDash = na
var label tlPlDashLab = na

f_trim_break_labs() =>
    while array.size(tlBreakLabs) > tlBreakMax
        label.delete(array.shift(tlBreakLabs))

f_add_break_lab(int xBar, float y, string txt, color col, bool isUp) =>
    array.push(tlBreakLabs, label.new(xBar, y, txt,
         style=isUp ? label.style_label_up : label.style_label_down,
         color=f_mark(col),
         textcolor=color.new(color.white, MARK_TRANS),
         size=size.small))
    f_trim_break_labs()

if not na(phRaw)
    if showPivotChannel
        label.new(pivBar, phRaw, "●",
             style=label.style_none,
             size=size.normal,
             textcolor=f_circle(tlPhColor),
             color=color.new(color.white, 100))
    if tlPhReady and pivBar != tlPhIndx
        float tlSlope = (phRaw - tlPhVal) / (pivBar - tlPhIndx)
        if showPivotChannel
            line.new(tlPhIndx, tlPhVal, pivBar, phRaw, width=2, color=f_mark(tlPhColor))
        if phRaw < tlPhVal and (tlPhVal - phRaw) >= atrCh
            if showPivotChannel
                line.new(pivBar, phRaw, pivBar + tlExtBars, phRaw + tlSlope * tlExtBars, style=tlExtStyle, color=f_mark(tlPhColor))
            tlUpperBar := pivBar
            tlUpperY := phRaw
            tlUpperSlope := tlSlope
            tlUpperOn := true
    tlPhVal := phRaw
    tlPhIndx := pivBar
    tlPhReady := true
    if showPivotChannel and showTlDashes
        line.delete(tlPhDash)
        label.delete(tlPhDashLab)
        tlPhDash := line.new(pivBar, phRaw, bar_index, phRaw, style=tlDashStyle, color=f_mark(tlPhColor), width=1)
        tlPhDashLab := label.new(bar_index, phRaw, text=str.tostring(phRaw, format.mintick), style=label.style_label_left, color=f_mark(tlPhColor), textcolor=color.new(color.white, MARK_TRANS), size=size.small)

if not na(plRaw)
    if showPivotChannel
        label.new(pivBar, plRaw, "●",
             style=label.style_none,
             size=size.normal,
             textcolor=f_circle(tlPlColor),
             color=color.new(color.white, 100))
    if tlPlReady and pivBar != tlPlIndx
        float tlSlope = (plRaw - tlPlVal) / (pivBar - tlPlIndx)
        if showPivotChannel
            line.new(tlPlIndx, tlPlVal, pivBar, plRaw, width=2, color=f_mark(tlPlColor))
        if tlPlVal < plRaw and (plRaw - tlPlVal) >= atrCh
            if showPivotChannel
                line.new(pivBar, plRaw, pivBar + tlExtBars, plRaw + tlSlope * tlExtBars, style=tlExtStyle, color=f_mark(tlPlColor))
            tlLowerBar := pivBar
            tlLowerY := plRaw
            tlLowerSlope := tlSlope
            tlLowerOn := true
    tlPlVal := plRaw
    tlPlIndx := pivBar
    tlPlReady := true
    if showPivotChannel and showTlDashes
        line.delete(tlPlDash)
        label.delete(tlPlDashLab)
        tlPlDash := line.new(pivBar, plRaw, bar_index, plRaw, style=tlDashStyle, color=f_mark(tlPlColor), width=1)
        tlPlDashLab := label.new(bar_index, plRaw, text=str.tostring(plRaw, format.mintick), style=label.style_label_left, color=f_mark(tlPlColor), textcolor=color.new(color.white, MARK_TRANS), size=size.small)

bool upMark = false
bool dnMark = false
if tlUpperOn
    int barsPassedUpper = bar_index - tlUpperBar
    if barsPassedUpper <= tlExtBars and barsPassedUpper >= 0
        float expectedUpper = tlUpperY + tlUpperSlope * barsPassedUpper
        if barstate.isconfirmed and low > expectedUpper
            upMark := true
            tlUpperOn := false
    else if barsPassedUpper > tlExtBars
        tlUpperOn := false
if tlLowerOn
    int barsPassedLower = bar_index - tlLowerBar
    if barsPassedLower <= tlExtBars and barsPassedLower >= 0
        float expectedLower = tlLowerY + tlLowerSlope * barsPassedLower
        if barstate.isconfirmed and high < expectedLower
            dnMark := true
            tlLowerOn := false
    else if barsPassedLower > tlExtBars
        tlLowerOn := false

if upMark and showPivotChannel and showTlDir
    f_add_break_lab(bar_index, low, "Up", tlPhColor, true)
if dnMark and showPivotChannel and showTlDir
    f_add_break_lab(bar_index, high, "Down", tlPlColor, false)
if not showTlDir or not showPivotChannel
    while array.size(tlBreakLabs) > 0
        label.delete(array.shift(tlBreakLabs))

if showPivotChannel and showTlDashes and barstate.islast
    if not na(tlPhDash)
        line.set_x2(tlPhDash, bar_index)
        label.set_x(tlPhDashLab, bar_index)
    if not na(tlPlDash)
        line.set_x2(tlPlDash, bar_index)
        label.set_x(tlPlDashLab, bar_index)

// ═══════════════════════════════════════════════════════════════════════
// RollE points — rolling extreme updates (causal; no forward confirm lag)
// ═══════════════════════════════════════════════════════════════════════
var int rePhBar = na
var float rePhVal = na
var int rePlBar = na
var float rePlVal = na
var label[] reHiLabs = array.new_label()
var label[] reLoLabs = array.new_label()
var line[] reHiLines = array.new_line()
var line[] reLoLines = array.new_line()
var line[] reHiExtLines = array.new_line()
var line[] reLoExtLines = array.new_line()

f_re_dash_all(line[] lines) =>
    int n = array.size(lines)
    if n > 0
        for i = 0 to n - 1
            line.set_style(array.get(lines, i), line.style_dashed)

f_re_solid_last(line[] lines) =>
    int n = array.size(lines)
    if n > 0
        line.set_style(array.get(lines, n - 1), line.style_solid)

float rolleWinHi = ta.highest(high, rolleLen)
float rolleWinLo = ta.lowest(low, rolleLen)
bool rolleUpdHi = bar_index >= rolleLen - 1 and high == rolleWinHi
bool rolleUpdLo = bar_index >= rolleLen - 1 and low == rolleWinLo

if not showRolleExt
    while array.size(reHiExtLines) > 0
        line.delete(array.shift(reHiExtLines))
    while array.size(reLoExtLines) > 0
        line.delete(array.shift(reLoExtLines))

if not showRollePoints
    while array.size(reHiLabs) > 0
        label.delete(array.shift(reHiLabs))
    while array.size(reLoLabs) > 0
        label.delete(array.shift(reLoLabs))
    while array.size(reHiLines) > 0
        line.delete(array.shift(reHiLines))
    while array.size(reLoLines) > 0
        line.delete(array.shift(reLoLines))
    while array.size(reHiExtLines) > 0
        line.delete(array.shift(reHiExtLines))
    while array.size(reLoExtLines) > 0
        line.delete(array.shift(reLoExtLines))
    rePhBar := na
    rePhVal := na
    rePlBar := na
    rePlVal := na

// Zone tracking for RollE always runs (even if dots/links hidden).
if barstate.isconfirmed
    if rolleUpdHi
        f_add_zone(reZonePhPrices, reZonePhBars, high, bar_index)
    if rolleUpdLo
        f_add_zone(reZonePlPrices, reZonePlBars, low, bar_index)

// Regime: bull/bear need RollE streak + MA + RSI; else sideways.
// Sideways is sticky until a new RollE update breaks with RollE-up / RollE-down structure.
// R mark: RollE update that is also a fractal pivot (lookback / lookforward bars).
var int reLastSide = 0  // +1 REH, -1 REL
var int reStreakN = 0
var int reRegimeState = 2  // 1 up, -1 down, 2 sideways
var label[] rHiLabs = array.new_label()
var label[] rLoLabs = array.new_label()

f_add_r_mark(label[] labs, int xBar, float y, bool isHi) =>
    array.push(labs, label.new(xBar, y, "R",
         style=isHi ? label.style_label_down : label.style_label_up,
         color=f_mark(isHi ? colRHi : colRLo),
         textcolor=color.new(color.white, MARK_TRANS),
         size=size.small))
    while array.size(labs) > rKeep
        label.delete(array.shift(labs))

// Pivot window = lookback + center + lookforward: R if that RollE bar is window high/low
int rolleRWin = rolleRLeft + rolleRRight + 1
int rePivotBar = math.max(0, bar_index - rolleRRight)
bool rePivotHiOk = bar_index >= rolleRWin - 1 and rolleUpdHi[rolleRRight] and high[rolleRRight] == ta.highest(high, rolleRWin)
bool rePivotLoOk = bar_index >= rolleRWin - 1 and rolleUpdLo[rolleRRight] and low[rolleRRight] == ta.lowest(low, rolleRWin)

if barstate.isconfirmed
    if showRMarks and rePivotHiOk
        f_add_r_mark(rHiLabs, rePivotBar, high[rolleRRight], true)
    if showRMarks and rePivotLoOk
        f_add_r_mark(rLoLabs, rePivotBar, low[rolleRRight], false)
    bool bothSides = rolleUpdHi and rolleUpdLo
    if bothSides
        reLastSide := 0
        reStreakN := 0
    else if rolleUpdHi
        reStreakN := reLastSide == 1 ? reStreakN + 1 : 1
        reLastSide := 1
    else if rolleUpdLo
        reStreakN := reLastSide == -1 ? reStreakN + 1 : 1
        reLastSide := -1

if not showRMarks
    while array.size(rHiLabs) > 0
        label.delete(array.shift(rHiLabs))
    while array.size(rLoLabs) > 0
        label.delete(array.shift(rLoLabs))

bool reStreakOk = reStreakN >= 2 and reLastSide != 0
// Against trend = full [high,low] clear on the wrong side of fast MA
bool barAgainstUp = high < maFast
bool barAgainstDn = low > maFast
float rsiMajor = ta.rsi(close, rsiRegLen)
// RollE-up / RollE-down structure (streak + MA); RSI gates bull/bear entry from non-sideways
bool rolleUp = reStreakOk and reLastSide == 1 and not barAgainstUp
bool rolleDn = reStreakOk and reLastSide == -1 and not barAgainstDn
bool bullOk = rolleUp and rsiMajor > rsiRegBull
bool bearOk = rolleDn and rsiMajor < rsiRegBear

if barstate.isconfirmed
    if reRegimeState == 2
        // Sticky sideways: only a new RollE up/down can break it
        if rolleUpdHi or rolleUpdLo
            if rolleUp
                reRegimeState := 1
            else if rolleDn
                reRegimeState := -1
    else
        if bullOk
            reRegimeState := 1
        else if bearOk
            reRegimeState := -1
        else
            reRegimeState := 2

int reRegime = reRegimeState

if showRollePoints and barstate.isconfirmed
    if rolleUpdHi
        array.push(reHiLabs, label.new(bar_index, high, "●",
             style=label.style_none,
             size=size.normal,
             textcolor=f_circle(colRolleHi),
             color=color.new(color.white, 100)))
        while array.size(reHiLabs) > rolleKeep
            label.delete(array.shift(reHiLabs))
        if not na(rePhBar) and rePhBar != bar_index
            float reHiSlope = (high - rePhVal) / (bar_index - rePhBar)
            if showRolleLinks
                array.push(reHiLines, line.new(rePhBar, rePhVal, bar_index, high,
                     width=2, color=f_mark(colRolleHi), style=line.style_solid))
                while array.size(reHiLines) > rolleKeep
                    line.delete(array.shift(reHiLines))
                f_re_dash_all(reHiLines)
                f_re_solid_last(reHiLines)
                f_re_dash_all(reLoLines)
            if showRolleExt and high < rePhVal and (rePhVal - high) >= atrCh
                array.push(reHiExtLines, line.new(bar_index, high, bar_index + tlExtBars, high + reHiSlope * tlExtBars,
                     style=line.style_dashed, color=f_mark(colRolleHi)))
                while array.size(reHiExtLines) > rolleKeep
                    line.delete(array.shift(reHiExtLines))
                f_re_dash_all(reHiExtLines)
                f_re_solid_last(reHiExtLines)
                f_re_dash_all(reLoExtLines)
        rePhBar := bar_index
        rePhVal := high
    if rolleUpdLo
        array.push(reLoLabs, label.new(bar_index, low, "●",
             style=label.style_none,
             size=size.normal,
             textcolor=f_circle(colRolleLo),
             color=color.new(color.white, 100)))
        while array.size(reLoLabs) > rolleKeep
            label.delete(array.shift(reLoLabs))
        if not na(rePlBar) and rePlBar != bar_index
            float reLoSlope = (low - rePlVal) / (bar_index - rePlBar)
            if showRolleLinks
                array.push(reLoLines, line.new(rePlBar, rePlVal, bar_index, low,
                     width=2, color=f_mark(colRolleLo), style=line.style_solid))
                while array.size(reLoLines) > rolleKeep
                    line.delete(array.shift(reLoLines))
                f_re_dash_all(reLoLines)
                f_re_solid_last(reLoLines)
                f_re_dash_all(reHiLines)
            if showRolleExt and rePlVal < low and (low - rePlVal) >= atrCh
                array.push(reLoExtLines, line.new(bar_index, low, bar_index + tlExtBars, low + reLoSlope * tlExtBars,
                     style=line.style_dashed, color=f_mark(colRolleLo)))
                while array.size(reLoExtLines) > rolleKeep
                    line.delete(array.shift(reLoExtLines))
                f_re_dash_all(reLoExtLines)
                f_re_solid_last(reLoExtLines)
                f_re_dash_all(reHiExtLines)
        rePlBar := bar_index
        rePlVal := low

// Safe zones
if barstate.isconfirmed
    if showZones
        color buyFill = color.new(colBuy, zoneTrans)
        color sellFill = color.new(colSell, zoneTrans)
        bool usePivotZ = zoneSource == "Swing pivots" or zoneSource == "Both"
        bool useRolleZ = zoneSource == "RollE" or zoneSource == "Both"
        if usePivotZ
            f_paint_zones(buyBoxes, sellBoxes, plPrices, plBars, phPrices, phBars, buyFill, sellFill)
        else
            f_clear_boxes(buyBoxes)
            f_clear_boxes(sellBoxes)
        if useRolleZ
            f_paint_zones(buyBoxesRe, sellBoxesRe, reZonePlPrices, reZonePlBars, reZonePhPrices, reZonePhBars, buyFill, sellFill)
        else
            f_clear_boxes(buyBoxesRe)
            f_clear_boxes(sellBoxesRe)
    else
        f_clear_boxes(buyBoxes)
        f_clear_boxes(sellBoxes)
        f_clear_boxes(buyBoxesRe)
        f_clear_boxes(sellBoxesRe)

plot(showMa ? maFast : na, "EMA Fast", color=f_mark(colFast), linewidth=1)
plot(showMa ? maMid : na, "EMA Mid", color=f_mark(colMid), linewidth=1)
plot(showMa ? maSlow : na, "EMA Slow", color=f_mark(colSlow), linewidth=1)
plot(showMa ? maLong : na, "SMA Long", color=f_mark(colLongMa), linewidth=2)

color regimeBg =
     not showRegime ? na :
     reRegime == 2 ? color.new(colRegSide, regimeTrans) :
     reRegime > 0 ? color.new(colRegUp, regimeTrans) :
     color.new(colRegDn, regimeTrans)
bgcolor(regimeBg, title="RollE regime")
